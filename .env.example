# ============================================================
# passion-index environment variables example.
# Copy to .env and fill in real values.
# ============================================================

# === Runtime ===
ENV=dev                                    # dev: hopebox/env loads .env; prod: container-injected
SILENT_LOG=false                           # true disables gorm SQL logging (read by hopebox/dao)

# === PostgreSQL (hopebox/dao) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=beacon_user
POSTGRES_PASSWORD=beacon_password
POSTGRES_DB=passion-index

# === Aliyun OSS (hopebox/aliyun) ===
# PDFs + parsed images live here.
ALIYUN_OSS_ACCESS_KEY=your_access_key
ALIYUN_OSS_ACCESS_SECRET=your_access_secret
ALIYUN_OSS_BUCKET=your_bucket
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# === MinerU OCR (hopebox/mineru_private, self-hosted) ===
MINERU_PRIVATE_BASE_URL=https://your-mineru-deploy.proxy.runpod.net
MINERU_PRIVATE_TOKEN=your_mineru_token

# === MinerU-Popo (hopebox/mineru_popo, structuring service) ===
MINERU_POPO_BASE_URL=http://localhost:8002
MINERU_POPO_TOKEN=                          # leave empty if the deployment needs no token

# === LLM (hopebox/llm) ===
# Model choices (leave empty for defaults).
PASSION_INDEX_SUMMARY_MODEL=deepseek-v4-flash              # primary model for node summaries
PASSION_INDEX_SUMMARY_FALLBACK_MODEL=HUOSHANG-doubao-seed-evolving  # fallback when the primary fails

# API keys
DEEP_SEEK_API_KEY=your_deepseek_api_key
HUO_SHANG_PLAN_API_KEY=your_huoshang_api_key

# === Semantic search (vector embeddings, hopebox/fastembed) ===
# fastembed service base URL; when unset, SearchDocuments(mode: SEMANTIC)
# and the pipeline's EMBEDDING step fail loudly. Default model
# BAAI/bge-small-en-v1.5 (384-dim); the dimension is hardcoded in
# models.EmbeddingDim — switching models means updating it, dropping the
# nodes.embedding column, and re-embedding documents.
FASTEMBED_URL=

# === passion-index itself ===
PASSION_INDEX_PORT=8900
