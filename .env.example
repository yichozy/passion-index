# ============================================================
# passion-index 环境变量示例
# 复制为 .env 并填入实际值
# ============================================================

# === 运行环境 ===
ENV=dev                                    # dev 时 hopebox/env 加载 .env;prod 走容器注入
SILENT_LOG=false                           # true 关闭 gorm SQL 日志(hopebox/dao 读)

# === PostgreSQL (hopebox/dao) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=beacon_user
POSTGRES_PASSWORD=beacon_password
POSTGRES_DB=passion-index

# === 阿里云 OSS (hopebox/aliyun) ===
# PDF + 解析后的图片都存这里
ALIYUN_OSS_ACCESS_KEY=your_access_key
ALIYUN_OSS_ACCESS_SECRET=your_access_secret
ALIYUN_OSS_BUCKET=your_bucket
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# === MinerU OCR (hopebox/mineru_private,私有化部署) ===
MINERU_PRIVATE_BASE_URL=https://your-mineru-deploy.proxy.runpod.net
MINERU_PRIVATE_TOKEN=your_mineru_token

# === MinerU-Popo (hopebox/mineru_popo,结构化服务) ===
MINERU_POPO_BASE_URL=http://localhost:8002
MINERU_POPO_TOKEN=                          # 部署不要 token 就留空

# === LLM (hopebox/llm) ===
# 模型选型(留空用默认值)
PASSION_INDEX_LEAF_MODEL=deepseek-v4-flash              # 叶子摘要主模型
PASSION_INDEX_LEAF_FALLBACK_MODEL=HUOSHANG-doubao-seed-evolving  # 主模型失败时的 fallback

# API keys
DEEP_SEEK_API_KEY=your_deepseek_api_key
HUO_SHANG_ARK_API_KEY=your_huoshang_api_key

# === passion-index 自身 ===
PASSION_INDEX_PORT=8900
